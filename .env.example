# memcp — environment variables. docker-compose.yml reads this file as .env. To run
# `memcp` without Docker, export them first: set -a; . ./.env; set +a
# Guide: https://github.com/Jartan-LLC/memcp/blob/main/docs/deployment.md

# Release for docker-compose.yml to run, 0.2.0 or later (default: the file's own)
# MEMCP_VERSION=0.2.0

# Backend selector (docker-compose.yml: sqlite; without it the default is mem0)
# Options: sqlite, in_memory, mem0
MEMCP_BACKEND=sqlite

# sqlite backend — durable, no API key, no account. Path to the database file.
# docker-compose.yml sets its own; without it, use an absolute path.
MEMCP_SQLITE_PATH=memcp.sqlite3

# mem0 backend config (required when MEMCP_BACKEND=mem0)
MEM0_API_BASE=https://your-mem0-instance.example.com
MEM0_API_KEY=your-mem0-api-key

# Auth token mapping, required by docker-compose.yml. Without Docker, empty means
# unauthenticated: accepted only on a loopback bind, as one tenant called default_user.
# Format: token1:user_id1,token2:user_id2
MEMCP_AUTH_TOKENS=

# Optional: gives a token an explicit seat distinct from its tenant, so two tokens
# can share a tenant (e.g. one shared MEMCP_AUTH_TOKENS entry) and still be
# individually attributed on every write. A token named here needs a matching
# MEMCP_AUTH_TOKENS entry. Format: token1:seat1,token2:seat2
MEMCP_AUTH_SEATS=

# Server bind. With no token set, anything other than 127.0.0.1 / localhost / ::1
# is refused at startup rather than served as an open memory store.
# docker-compose.yml sets its own host and port; these apply without it.
MEMCP_HOST=127.0.0.1
MEMCP_PORT=8080

# Host header allow-list for DNS-rebinding protection, comma-separated; `:*` admits
# any port. Unset leaves the MCP SDK's own rule, which turns protection on only when
# MEMCP_HOST is loopback — so a 0.0.0.0 bind validates no Host header unless you set
# this. Origins are derived from the same list over http and https.
# MEMCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,memory.example.com

# Logging (optional)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
MEMCP_LOG_LEVEL=INFO
# Options: json, plain
MEMCP_LOG_FORMAT=json
