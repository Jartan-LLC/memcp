# Dependencies, caches and build artifacts
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# Leading / matches the root only, so same-named source dirs elsewhere are tracked and packaged
/.eggs/
/dist/
/build/
*.egg
*.whl

# Environment
.env
.env.*
!.env.example
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing / Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docs build output (Sphinx)
docs/_build/

# The pinned mem0 checkout tests/mem0 builds
tests/mem0/.mem0/

# Logs
*.log
/logs/

# Claude workspace (plans, scratch files)
.claude/workspace/*
!.claude/workspace/.gitkeep

# Claude local settings (user-specific)
.claude/settings.local.*

# Liza: runtime state, the local contract link, provider key files, and the indexes its
# git hooks regenerate after each commit
.liza/
.worktrees/
.adversarial/
CLAUDE.local.md
stacklit.json
/*.scip
functional-clusters.json
claude.env
pi.env
